---
import { nav, site } from '../data/site'
const path = Astro.url.pathname
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href))
---

<header class="hdr">
  <div class="wrap hdr__inner">
    <a href="/" class="logo" aria-label={`${site.name} — Startseite`}>
      <span class="logo__mark display">AS</span>
      <span class="logo__text">
        <span class="display logo__name">Ars Saltandi</span>
        <span class="logo__sub">Hildesheim</span>
      </span>
    </a>

    <input type="checkbox" id="navtoggle" class="navtoggle visually-hidden" />
    <label for="navtoggle" class="burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Hauptnavigation">
      <div class="nav__inner">
        <ul class="nav__list">
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="/probestunde/" class="btn btn--sm">Probestunde</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--ink) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .hdr__inner { display: flex; align-items: center; gap: 1rem; padding-block: 0.8rem; }

  .logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; margin-right: auto; }
  .logo__mark {
    display: grid; place-items: center;
    width: 2.4rem; height: 2.4rem; border-radius: 8px;
    background: var(--hot); color: #fff; font-size: 1.35rem; padding-top: 0.12em;
  }
  .logo__text { display: flex; flex-direction: column; line-height: 1; }
  .logo__name { font-size: 1.35rem; letter-spacing: 0.04em; }
  .logo__sub { font-size: 0.62rem; letter-spacing: 0.26em; text-transform: uppercase; color: var(--fg-muted); }

  .nav__inner { display: flex; align-items: center; gap: clamp(0.8rem, 2vw, 1.6rem); }
  .nav__list { display: flex; gap: clamp(0.7rem, 1.8vw, 1.5rem); list-style: none; padding: 0; margin: 0; }
  .nav__list a {
    text-decoration: none; font-size: var(--step--1); font-weight: 600;
    letter-spacing: 0.04em; color: var(--fg-muted); white-space: nowrap;
    transition: color 0.15s;
  }
  .nav__list a:hover, .nav__list a[aria-current='page'] { color: var(--fg); }
  .nav__list a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--hot); text-decoration-thickness: 2px; }

  .btn--sm { padding: 0.6em 1.1em; font-size: 0.72rem; }

  .burger { display: none; }

  @media (max-width: 900px) {
    .burger {
      display: grid; gap: 5px; padding: 0.55rem; cursor: pointer;
      border: 1px solid var(--line); border-radius: 8px;
    }
    .burger span { display: block; width: 20px; height: 2px; background: var(--fg); transition: 0.2s; }

    /* Ein einziges Grid-Kind (.nav__inner), damit 0fr -> 1fr die gesamte
       Navigation animiert. Mit zwei Kindern landet das zweite in einer
       impliziten Zeile mit auto-Höhe und bleibt sichtbar. */
    .nav {
      position: absolute; inset: 100% 0 auto 0;
      background: var(--ink-2); border-bottom: 1px solid var(--line);
      padding: 0 var(--gutter);
      display: grid; grid-template-rows: 0fr;
      transition: grid-template-rows 0.25s ease;
      overflow: hidden;
    }
    .nav__inner { min-height: 0; overflow: hidden; flex-direction: column; align-items: stretch; gap: 0; }
    .nav__list { flex-direction: column; gap: 0; }
    .nav__list a { display: block; padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-size: var(--step-0); }
    .nav .btn { margin: 1rem 0 1.4rem; justify-content: center; }

    .navtoggle:checked ~ .nav { grid-template-rows: 1fr; }
    .navtoggle:checked ~ .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .navtoggle:checked ~ .burger span:nth-child(2) { opacity: 0; }
    .navtoggle:checked ~ .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .navtoggle:focus-visible ~ .burger { outline: 3px solid var(--electric); outline-offset: 3px; }
  }
</style>
