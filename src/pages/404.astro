---
import Base from '../layouts/Base.astro'
---
<Base title="Seite nicht gefunden">
  <div class="wrap-narrow center">
    <p class="eyebrow">404</p>
    <h1 class="display t">Diese Seite gibt es nicht</h1>
    <p class="lead text-muted">
      Vielleicht wurde sie verschoben. Am schnellsten findest du dich über den
      Stundenplan oder die Kursübersicht zurecht.
    </p>
    <div class="cluster" style="justify-content: center; margin-top: 2rem;">
      <a href="/kurse/" class="btn">Zu den Kursen</a>
      <a href="/stundenplan/" class="btn btn--ghost">Zum Stundenplan</a>
    </div>
  </div>
</Base>
<style>
  .center { text-align: center; padding-block: clamp(3rem, 10vw, 7rem); }
  .t { font-size: var(--step-3); margin-block: 0.5rem 1.2rem; }
  .lead { font-size: var(--step-1); }
</style>
