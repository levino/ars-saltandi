---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'

export const getStaticPaths = (async () => {
  const posts = await getCollection('news', (n) => !n.data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content } = await render(post)
const fmt = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })
---

<Base title={post.data.title} description={post.data.summary}>
  <div class="wrap-narrow">
    <nav class="crumbs text-muted"><a href="/news/">News</a></nav>
    <header class="head">
      <time class="eyebrow" datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
      <h1 class="display title">{post.data.title}</h1>
      <p class="lead text-muted">{post.data.summary}</p>
    </header>
    <article class="prose"><Content /></article>
    <a href="/news/" class="btn btn--ghost back">← Alle News</a>
  </div>
</Base>

<style>
  .crumbs { font-size: var(--step--1); margin-bottom: 1.5rem; }
  .crumbs a { color: var(--hot); }
  .head { margin-bottom: 2.5rem; }
  .title { font-size: var(--step-3); margin-block: 0.5rem 1rem; }
  .lead { font-size: var(--step-1); }
  .back { margin-block: 3rem 5rem; }
</style>
