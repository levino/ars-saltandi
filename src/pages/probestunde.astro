---
import Base from '../layouts/Base.astro'
import Form from '../components/Form.astro'
import { getCollection } from 'astro:content'
import { site } from '../data/site'

const courses = (await getCollection('courses', (c) => !c.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<Base
  title="Probestunde"
  description="Probestunde bei ARS SALTANDI in Hildesheim vereinbaren — unverbindlich ausprobieren, in jedem Kurs."
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Unverbindlich ausprobieren</p>
      <h1 class="display page-title">Probestunde</h1>
      <p class="page-lead text-muted">
        Schreib uns, welcher Kurs dich interessiert — wir melden uns mit einem Termin.
        Die Probestunde ist kostenlos und verpflichtet zu nichts.
      </p>
    </header>

    <div class="layout">
      <Form name="Probestunde" subject="Anfrage Probestunde" submitLabel="Anfrage senden">
        <div class="row">
          <p class="field">
            <label class="field__label" for="vorname">Vorname</label>
            <input id="vorname" name="Vorname" type="text" required autocomplete="given-name" placeholder=" " />
          </p>
          <p class="field">
            <label class="field__label" for="nachname">Nachname</label>
            <input id="nachname" name="Nachname" type="text" required autocomplete="family-name" placeholder=" " />
          </p>
        </div>

        <div class="row">
          <p class="field">
            <label class="field__label" for="alter">Alter</label>
            <input id="alter" name="Alter" type="number" min="3" max="99" required placeholder=" " />
          </p>
          <p class="field">
            <label class="field__label" for="kurs">Gewünschter Kurs</label>
            <select id="kurs" name="Kurs" required>
              <option value="">Bitte wählen</option>
              {courses.map((c) => <option value={c.data.title}>{c.data.title}</option>)}
              <option value="Noch unklar">Weiß ich noch nicht — bitte beraten</option>
            </select>
          </p>
        </div>

        <div class="row">
          <p class="field">
            <label class="field__label" for="email">E-Mail</label>
            <input id="email" name="E-Mail" type="email" required autocomplete="email" placeholder=" " />
          </p>
          <p class="field">
            <label class="field__label" for="telefon">Telefon</label>
            <input id="telefon" name="Telefon" type="tel" autocomplete="tel" placeholder=" " />
          </p>
        </div>

        <p class="field">
          <label class="field__label" for="nachricht">Nachricht</label>
          <textarea id="nachricht" name="Nachricht" placeholder="Gibt es etwas, das wir wissen sollten?"></textarea>
        </p>
      </Form>

      <aside class="side">
        <div class="panel">
          <h2 class="panel__h">Lieber anrufen?</h2>
          <p><a class="big-link" href={`tel:${site.phone}`}>{site.phoneDisplay}</a></p>
          <p class="text-muted">Wochentags erreichbar.</p>
          <p style="margin-top: 1rem;"><a class="big-link" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="panel">
          <h2 class="panel__h">Was mitbringen?</h2>
          <ul class="list">
            <li>Bequeme Sportkleidung</li>
            <li>Etwas zu trinken</li>
            <li>Für Tanzkurse: Socken oder Gymnastikschläppchen</li>
            <li>Für Artistikkurse: eng anliegendes Oberteil, das die Achseln bedeckt</li>
          </ul>
        </div>
        <div class="panel">
          <h2 class="panel__h">Danach</h2>
          <p class="text-muted">
            Wenn es passt, füllst du das <a href="/anmeldung/">Anmeldeformular</a> aus.
            Die <a href="/preise/">Preise</a> findest du vorher hier.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    // Kurs aus dem Link vorauswählen (/probestunde/?kurs=Ballett)
    const wanted = new URLSearchParams(location.search).get('kurs')
    if (wanted) {
      const select = document.getElementById('kurs')
      if (select instanceof HTMLSelectElement) {
        const hit = [...select.options].find((o) => o.value === wanted)
        if (hit) select.value = wanted
      }
    }
  </script>
</Base>

<style>
  .page-head { margin-bottom: 3rem; }
  .page-title { font-size: var(--step-4); margin-block: 0.4rem 1rem; }
  .page-lead { font-size: var(--step-1); max-width: 54ch; }

  .layout { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; margin-bottom: 5rem; }
  @media (min-width: 900px) { .layout { grid-template-columns: minmax(0, 1fr) 320px; } }

  .side { display: grid; gap: 1.2rem; }
  .panel { padding: 1.5rem; background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius); }
  .panel__h { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 1rem; }
  .panel p { font-size: var(--step--1); }
  .panel a:not(.big-link) { color: var(--accent); }
  .big-link { font-size: var(--step-1); font-weight: 700; text-decoration: none; }
  .big-link:hover { color: var(--accent); }
  .list { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.5rem; font-size: var(--step--1); color: var(--fg-muted); }
</style>
